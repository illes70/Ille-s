# Claude – az asszisztens agya
ANTHROPIC_API_KEY=

# Meta Marketing API (ha üres, az OCP demó adatokkal fut)
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_
META_PAGE_ID=

# Az ütemezett figyelő (cron) végpont védelme
CRON_SECRET=

# Meta webhook (azonnali leadek): a Meta appban megadott verify token
META_VERIFY_TOKEN=

# Az OCP nyilvános címe (webhookhoz és a Facebook bejelentkezés visszairányításához), pl. https://ocp.example.hu
OCP_PUBLIC_URL=
# Meta lekérdezési gyakoriság másodpercben (élő frissítés)
META_POLL_SECONDS=60

# Opcionális AI képgenerálás (OpenAI API, képenként fizetős)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# Belépés: a sütik aláírókulcsa (szerveren állítsd be; helyben automatikusan generálódik)
OCP_SECRET=
# 1 = a regisztráció nyitva marad az első (tulajdonos) fiók után is
OCP_ALLOW_SIGNUP=
