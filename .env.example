# ── Claude – az asszisztens agya ──────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Meta app (az egygombos „Csatlakoztatás Facebookkal”-hoz) ──────────────────
META_APP_ID=
META_APP_SECRET=
# Facebook Login for Business konfiguráció azonosítója (ajánlott). Ha üres: klasszikus Facebook Login.
META_CONFIG_ID=
# Meta webhook (azonnali leadek): ugyanez a szöveg kell a Meta app Webhooks beállításához
META_VERIFY_TOKEN=

# Fejlesztői token (csak a tulajdonos fiókjára érvényes, más ügyfélre soha). Normál esetben üres:
# mindenki – te is – a „Csatlakoztatás Facebookkal” gombbal köti be magát.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=

# ── A szerver ─────────────────────────────────────────────────────────────────
# Az OCP nyilvános címe, pl. https://ocp.example.hu (webhook, Facebook visszairányítás, e-mail linkek)
OCP_PUBLIC_URL=
# A belépési sütik aláírókulcsa – szerveren KÖTELEZŐ, hosszú véletlen szöveg (pl. openssl rand -hex 32)
OCP_SECRET=
# 1 = bárki regisztrálhat meghívó nélkül (alapból csak meghívó linkkel)
OCP_ALLOW_SIGNUP=

# ── 0–24 robot ────────────────────────────────────────────────────────────────
# Meta frissítés másodpercben, ha valaki nézi az appot / ha senki
META_POLL_SECONDS=60
META_IDLE_POLL_SECONDS=300
# off = a háttérrobot nem indul (pl. több példány esetén csak egy futtassa)
OCP_ENGINE=
# Opcionális külső ütemező végpont (/api/cron/scan) védelme
CRON_SECRET=

# ── Értesítések ───────────────────────────────────────────────────────────────
# E-mail (resend.com, ingyenes csomag elég): API kulcs és feladó
RESEND_API_KEY=
OCP_MAIL_FROM=OCP <ocp@yourdomain.hu>
# Push értesítés kulcsai (ha üres, automatikusan generálódik a .data mappába)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Adatkezelési tájékoztató (/privacy) ───────────────────────────────────────
OCP_OPERATOR_NAME=
OCP_OPERATOR_EMAIL=

# ── AI képgenerálás (bármelyik elég; az OCP a beállított minőség szerint választ) ──
# Ingyenes: Cloudflare Workers AI (FLUX) – napi ingyenes keret
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# Erős (~0,04 $/kép, valódi fotót is feljavít): Google Gemini „Nano Banana”
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Opcionális Gemini pro képmodell a „Prémium” szinthez
GEMINI_IMAGE_PRO_MODEL=
# Prémium (ChatGPT képmodellje, ~0,05–0,2 $/kép): OpenAI
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# ── Asszisztens modell felülírása (alapból a Beállítások → AI és költségek dönt) ──
OCP_MODEL=
OCP_EFFORT=
